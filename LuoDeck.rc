// 自备资源脚本：qmake 自动生成的那份没有指定代码页，rc.exe 会按 ANSI（GBK）编译里面的
// UTF-8 中文，结果 "Windows 图标启动面板" 在通知横幅、任务管理器里全是乱码
// （Windows 内部一直乱码显示成 "Windows 鍥炬爣鍚姩闈㈡澘"）。
// 这里显式切到 UTF-8 代码页，StringFileInfo 也标成中文（0x0804）。
// 改动 exe 元数据版本号时，这里的 FILEVERSION / FileVersion / ProductVersion
// 要和 src/version.h 里的显示版本（1.02）保持一致。

#include <windows.h>

#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "LuoDeck\0"
            VALUE "FileDescription", "Windows 图标启动面板\0"
            VALUE "FileVersion", "1.0.2.0\0"
            VALUE "LegalCopyright", "MIT License\0"
            VALUE "OriginalFilename", "LuoDeck.exe\0"
            VALUE "ProductName", "LuoDeck\0"
            VALUE "ProductVersion", "1.0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
